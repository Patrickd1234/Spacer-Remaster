# Copy to .env for local development; on Vercel set these under
# Project Settings -> Environment Variables (Production, Preview, Development).
# Both values come from Supabase -> Project Settings -> API.
# The anon key is public by design (it ships in the browser bundle); database
# access is enforced by row-level security, never by keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile CAPTCHA on sign-in, sign-up and password reset.
# The SITE key only (public, from Cloudflare -> Turnstile). The SECRET key goes
# in Supabase -> Authentication -> Attack Protection, never here. Leave empty
# to turn the CAPTCHA off (local development).
VITE_TURNSTILE_SITE_KEY=

# Optional: Sentry error monitoring (Sentry -> Project Settings -> Client Keys
# (DSN)). The DSN is public by design; it only allows sending error reports.
# Leave empty to turn monitoring off (local development).
VITE_SENTRY_DSN=
