# Copy to .env for local development; on Vercel set these under
# Project Settings -> Environment Variables (Production, Preview, Development).
# Both values come from Supabase -> Project Settings -> API.
# The anon key is public by design (it ships in the browser bundle); database
# access is enforced by row-level security, never by keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
